{
  "manifest_version": 3,
  "name": "Duck Everything",
  "version": "2.1.1",
  "description": "Controle global de cópia, seleção, fullscreen e foco com opções independentes.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "browser-shim.js",
      "defaults.js",
      "capture.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Duck Everything",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "duck-everything@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  }
}